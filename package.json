{
  "name": "piner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --import ./scripts/register-ts.mjs server/index.ts",
    "build": "tsc -b && vite build && node scripts/build-api.mjs",
    "lint": "eslint .",
    "test": "node --import ./scripts/register-ts.mjs --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heyphat/piner": "^0.11.1",
    "lightweight-charts": "^5.2.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
